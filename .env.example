# LockWatch Production Environment Variables
# Section 99 Configuration Specification

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:your_password@localhost:5432/lockwatch

# Authentication & JWT Secrets
JWT_SECRET=your_jwt_signing_secret_min_64_chars
REFRESH_SECRET=your_refresh_token_secret_min_64_chars
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN_DAYS=7

# Caching & PubSub (Redis)
REDIS_URL=redis://localhost:6379

# Service URLs
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Push Notifications (Firebase Cloud Messaging - Android)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# Push Notifications & APNs (Apple iOS / iPadOS)
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_PRIVATE_KEY\n-----END PRIVATE KEY-----"
APNS_TOPIC=com.lockwatch.app
APP_BUNDLE_ID=com.lockwatch.app

# Examination System Defaults
DEFAULT_EMERGENCY_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=5
STALE_THRESHOLD_SECONDS=15
OFFLINE_THRESHOLD_SECONDS=30
