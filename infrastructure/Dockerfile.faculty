FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY apps/faculty-web/ ./apps/faculty-web/

RUN npm install
RUN npm run build:packages
RUN npm run build --workspace=@lockwatch/faculty-web

FROM nginx:alpine AS runner

COPY --from=builder /app/apps/faculty-web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
